{
  "name": "genesis",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "소설 프로젝트 제로 홍보 홈페이지",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build-storybook && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fsd": "steiger src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:deployed": "playwright test e2e/offline.spec.ts",
    "visual:docker": "node scripts/visual-docker.mjs",
    "check": "node scripts/check.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook --quiet",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "screenshots": "node scripts/screenshots.mjs && node scripts/og-image.mjs",
    "og-image": "node scripts/og-image.mjs",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^11.12.0",
    "@stylexjs/stylex": "^0.19.2",
    "ky": "^1.14.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@stylexjs/babel-plugin": "^0.19.2",
    "@stylexjs/postcss-plugin": "^0.19.2",
    "@stylexjs/unplugin": "^0.19.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "babel-loader": "^10.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fontverter": "2.1.0",
    "harfbuzzjs": "1.6.4",
    "jsdom": "^31.0.1",
    "size-limit": "^14.3.0",
    "steiger": "^0.10.0",
    "storybook": "^10.6.7",
    "subset-font": "2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
